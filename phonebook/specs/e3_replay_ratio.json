{
  "name": "e3_replay_ratio",
  "description": "The phonebook README's replay question: replay data holds one copy of A and k copies of B. How fast is joint exact recall reached, and how deep does A's dip go, as k and the learning rate vary?",
  "seed": 42,
  "model_config": "phonebook/config/phonebook.py",
  "evaluate_books": [
    "A",
    "B"
  ],
  "require_one_update_per_epoch": true,
  "timeout_seconds": 1800,
  "decision_rules": {
    "question": "Does repeating B ever reach exact recall of both books in fewer updates than the balanced mixture (k=1), and what does it do to the transient forgetting of A?",
    "first_joint": "First update at which every training sequence (so both books) is recalled exactly.",
    "stable_joint": "First update from which every logged update through update 500 has both books recalled exactly. Runs that never get there are censored and count as infinitely slow.",
    "best_k_per_lr": "For each learning rate, k* is the k with the smallest median stable_joint over the three checkpoints; ties go to the smaller k. If every k is censored there is no k*.",
    "dip": "The minimum number of A entries recalled at any update, and the update where it first occurs.",
    "cross_checks": "k=1 at lr=0.001 must reproduce E1's replay_a1b1 curves exactly (batch size 64 versus 128 is irrelevant for a single batch). k=1 at lr=0.0001 must reproduce last week's 100-update results: B recalled 0/10, 1/10 and 0/10 on the three checkpoints.",
    "reporting": "Every cell is reported, including censored ones."
  },
  "scenarios": [
