{
  "name": "e5_phase_a_s123",
  "description": "Fresh Phase-A models (init seed 123), one per phonebook: train on book A, evaluate on book B, the same recipe as E2's Phase A.",
  "seed": 123,
  "model_config": "phonebook/config/phonebook.py",
  "evaluate_books": [
    "A",
    "B"
  ],
  "require_one_update_per_epoch": true,
  "decision_rules": {
    "gate": "Each Phase-A checkpoint must recall all ten entries of its own book A exactly. If one does not after 100 updates, that phonebook is retrained from scratch with 200 and then 400 updates (a new spec each time) and every attempt is kept as evidence. The main-grid generator refuses a checkpoint that fails the gate."
  },
  "scenarios": [
    {
      "id": "pb2",
      "book_a": "phonebook/inputs/heldout_seed2_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed2_phonebookB.txt"
    },
    {
      "id": "pb4",
      "book_a": "phonebook/inputs/heldout_seed4_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed4_phonebookB.txt"
    },
    {
      "id": "pb7",
      "book_a": "phonebook/inputs/heldout_seed7_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed7_phonebookB.txt"
    },
    {
      "id": "pb8",
      "book_a": "phonebook/inputs/heldout_seed8_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed8_phonebookB.txt"
    },
    {
      "id": "pb9",
      "book_a": "phonebook/inputs/heldout_seed9_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed9_phonebookB.txt"
    },
    {
      "id": "pb12",
      "book_a": "phonebook/inputs/heldout_seed12_phonebookA.txt",
      "book_b": "phonebook/inputs/heldout_seed12_phonebookB.txt"
    }
  ],
  "conditions": [
    {
      "id": "phase_a",
      "train": {
        "a_copies": 1,
        "b_copies": 0
      },
      "eval_book": "B",
      "lr": 0.001,
      "epochs": 100,
      "batch_size": 64,
      "accuracy_interval": 10,
      "adapt": false
    }
  ]
}
