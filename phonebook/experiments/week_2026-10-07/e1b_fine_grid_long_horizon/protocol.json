  "spec": {
    "name": "e1b_fine_grid_long_horizon",
    "description": "L2-SP lambda in tenth-steps across the transition where B stops being learned (0.3 to 1.0), on E1's three checkpoints, for 1000 updates logged every 5 updates. Follow-up to E1.",
    "seed": 42,
    "model_config": "phonebook/config/phonebook.py",
    "evaluate_books": [
      "A",
      "B"
    ],
    "require_one_update_per_epoch": true,
    "timeout_seconds": 1800,
    "decision_rules": {
      "why": "E1's half-decade grid is coarse next to the lambda range where L2-SP stops learning B, and 300 updates may be short for strong penalties. A 'no lambda matches replay' conclusion should survive a finer grid and a longer horizon.",
      "rule": "E1's rule, unchanged: L2-SP matches replay if one lambda gives A=10/10 and B=10/10 on at least 2 of 3 checkpoints; it nearly matches with A>=9/10 and B=10/10. Applied at 100, 300 and 1000 updates over the union of E1's and E1b's lambda values; the 1000-update budget uses E1b's lambda values only.",
      "cross_check": "The rows of the lambda=0.3 and lambda=1.0 runs at updates 5, 10, ..., 300 must equal E1's rows at the same updates.",
      "reporting": "Every grid point is reported, including failures."
    },
    "scenarios": [
