  "spec": {
    "name": "e1_matched_lr",
    "description": "L2-SP versus plain fine-tuning versus balanced replay at the trainer's default learning rate (0.001), with exact A/B recall logged after every update. Phase-B seed is fixed at 42: with one batch per epoch the update does not depend on shuffling.",
    "seed": 42,
    "model_config": "phonebook/config/phonebook.py",
    "evaluate_books": [
      "A",
      "B"
    ],
    "require_one_update_per_epoch": true,
    "decision_rules": {
      "question": "Can L2-SP, which needs no old data, retain phonebook A and also learn phonebook B once the optimizer can learn B (lr=0.001)? How does it compare with plain fine-tuning and balanced replay?",
      "primary_endpoint": "Exact recall counts (of 10 entries) for book A and book B after 100 updates, read from the logged teacher-forced sequence accuracies. These equal strict generation recall (verified on 40 book evaluations last week); every 300-update endpoint is also evaluated by strict generation and must agree.",
      "secondary_endpoint": "The same counts after 300 updates, and the full per-update curves.",
      "l2sp_matches_replay": "L2-SP matches replay at a budget if one lambda gives A=10/10 and B=10/10 on at least 2 of the 3 Phase-A checkpoints. It nearly matches if one lambda gives A>=9/10 and B=10/10 on at least 2 of 3.",
      "lambda_for_replication": "For the held-out replication, use the lambda with the largest sum over the 3 checkpoints of (A + B) correct at 100 updates; break ties by the larger summed A, then by the smaller lambda.",
      "reporting": "Every grid point is reported, including failures. Best-epoch-in-hindsight numbers are exploratory and never the headline."
    },
    "scenarios": [
      {
