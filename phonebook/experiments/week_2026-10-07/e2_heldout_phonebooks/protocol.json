    "name": "e2_heldout_phonebooks",
    "description": "E1 repeated exactly (same 11 conditions, learning rate, updates, per-update logging) on three new 20-entry phonebooks, each with its own fresh Phase-A model.",
    "seed": 42,
    "model_config": "phonebook/config/phonebook.py",
    "evaluate_books": [
      "A",
      "B"
    ],
    "require_one_update_per_epoch": true,
    "decision_rules": {
      "replication": "E1's conclusions replicate if, on at least 2 of the 3 new phonebooks: (i) balanced replay recalls 10/10 of both books after 100 updates; (ii) plain fine-tuning ends 300 updates with B=10/10 and at most 2 of A recalled; and (iii) the L2-SP decision rule applied to the 3 new phonebooks over the same grid gives the same verdict as E1 at both 100 and 300 updates.",
      "lambda": "The whole grid is repeated, so no lambda is carried over from E1."
    },
